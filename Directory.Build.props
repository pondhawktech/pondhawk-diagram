<Project>

    <PropertyGroup>
        <!--
          The last released version. The promote workflow bumps and commits it, and passes the
          release version as -p:Version. A build without that gets the suffix, so a hand-built
          binary is never mistaken for one that shipped.
        -->
        <VersionPrefix>0.1.0</VersionPrefix>
        <VersionSuffix Condition="'$(Version)' == ''">dev</VersionSuffix>
        <Product>pondhawk-diagram</Product>
        <Company>Pondhawk Technologies</Company>
        <Copyright>Copyright (c) 2026 Pondhawk Technologies</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Pondhawk Technologies</Authors>
        <PackageProjectUrl>https://github.com/pondhawktech/pondhawk-diagram</PackageProjectUrl>
        <!-- GitHub Packages uses this to attach a pushed package to the repository -->
        <RepositoryUrl>https://github.com/pondhawktech/pondhawk-diagram</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

</Project>
