<Project>

    <PropertyGroup>
        <!--
          The release tag is the source of truth. CI passes the tag through as -p:Version, and
          this default is what a local build gets — deliberately not a plausible release number,
          so a hand-built binary is never mistaken for one that shipped.
        -->
        <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
        <Product>pondhawk-diagram</Product>
        <Company>Pondhawk Technologies</Company>
        <Copyright>Copyright (c) 2026 Pondhawk Technologies</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

</Project>
