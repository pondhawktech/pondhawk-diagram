<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>pondhawk-diagram</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>pondhawk-diagram</ToolCommandName>
        <PackageId>Pondhawk.Diagram.Tool</PackageId>
        <Description>Command-line tool that draws an interactive HTML ER diagram from a JSON data model.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pondhawk.Diagram\Pondhawk.Diagram.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Pondhawk.Diagram.Tool.Tests" />
    </ItemGroup>

</Project>
